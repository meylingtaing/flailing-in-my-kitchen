%# For the whole "left side" of the page
<div class="grid-sidebar">

  %= include '_mini_about';

  <div class="sidebar-box">
    <div id="white-box-sidebar" class="white-box-container">
      %= include '_sidebar_links';
      <%= $sidebar_content %>
    </div>

    <img src="/kitchen-sm.png" class="fanart" title="Digital drawing of 'flailing in my kitchen' with a dog making and spilling eggs in the kitchen. Created by bogo" />

    % if (my $tagline_links = stash('tagline_links')) {
      <div class="blog-tagline below-sidebar-box">
        How can I be sad when I have<br><%== $tagline_links %>?
      </div>
    % }

  </div>

</div>
